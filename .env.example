# ============================================================
# AI Research Assistant - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ----------------------------------------------------------
# HuggingFace API (Free LLM)
# Get your token from: https://huggingface.co/settings/tokens
# ----------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# ----------------------------------------------------------
# Optional: Alternative Search APIs
# ----------------------------------------------------------
# SERPAPI_API_KEY=your_serpapi_key_here   # Google SerpAPI
# BING_API_KEY=your_bing_search_key_here  # Bing Search

# ----------------------------------------------------------
# App Settings
# ----------------------------------------------------------
# LLM model to use from HuggingFace Hub
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2

# Maximum search results per query
MAX_SEARCH_RESULTS=5

# Chunk size for text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Cache settings
CACHE_DIR=.cache
CACHE_TTL_HOURS=24

# ChromaDB persistence directory
CHROMA_DIR=.chroma_db
